# Secrets must never enter the build context: they would be baked into the
# build stage's layers even though the final image only copies the binary.
# Glob-then-allow rather than naming .env.prod, so a future .env.<whatever>
# is excluded by default instead of silently shipping.
.env
.env.*
!.env.example
!.env.prod.example

# Not needed to build the binary.
/api
/backups
Makefile
README.md
Dockerfile
.dockerignore
.gitignore
docker-compose.yml
docker-compose.prod.yml
Caddyfile
