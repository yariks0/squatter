# Production secrets. Copy to `.env.prod` ON THE DROPLET and fill in — never
# commit the filled copy (.gitignore covers .env.prod) and never bake it into
# the image (.dockerignore covers it).
#
#   cp .env.prod.example .env.prod
#   chmod 600 .env.prod       # root-only; it holds every credential
#   make prod-up
#
# `make prod-up` passes this file to compose twice: as --env-file (so the
# ${...} in docker-compose.prod.yml resolve) and as the api service's env_file
# (so the API process sees these). Editing it requires `make prod-restart` —
# compose does not re-read it on its own.

# --- Deployment shape --------------------------------------------------------
# The hostname the iOS app will call. Its A record must already point at this
# droplet's public IP, or Caddy's certificate request will fail.
API_DOMAIN=api.example.com
# Let's Encrypt uses this only for expiry warnings.
ACME_EMAIL=you@example.com

# --- Secrets -----------------------------------------------------------------
# Postgres password. Generate once, then leave alone — changing it after the
# volume exists does NOT change the password in the database.
#   openssl rand -hex 32
POSTGRES_PASSWORD=

# The coach proxy's server-held Anthropic key. /v1/coach 500s without it.
#   https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Resend key for login-code emails. Unlike dev, DO NOT leave this empty in
# production: an empty key silently falls back to printing login codes to the
# server log, which makes every account loggable-into by anyone with log access.
#   https://resend.com/api-keys
RESEND_API_KEY=
# Must be a domain verified in Resend. resend.dev only delivers to your own
# signup address — real users will not receive their codes.
EMAIL_FROM=Squatter <login@example.com>

# --- Tunables ----------------------------------------------------------------
COACH_MODEL=claude-opus-4-8
COACH_DAILY_LIMIT=20
TOKEN_TTL_DAYS=90
CODE_TTL_MINUTES=10

# DATABASE_URL, ENV, PORT and TRUST_PROXY are set by docker-compose.prod.yml
# and intentionally not listed here.
