# Copy to .env for docker compose. Compose overrides DATABASE_URL to reach
# the db service; set it here too for `make run` against the compose db.
PORT=8080
DATABASE_URL=postgres://squatter:squatter@localhost:5433/squatter?sslmode=disable

# The coach proxy's server-held key. Required for /v1/coach to work.
ANTHROPIC_API_KEY=
COACH_MODEL=claude-opus-4-8
COACH_DAILY_LIMIT=20

# Email. Leave RESEND_API_KEY empty to log login codes to stdout instead of
# sending them (dev mode — no email account needed).
RESEND_API_KEY=
EMAIL_FROM=Squatter <onboarding@resend.dev>

ENV=dev
TOKEN_TTL_DAYS=90
CODE_TTL_MINUTES=10
